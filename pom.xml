<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>
  <groupId>com.hawkins</groupId>
  <artifactId>gallery-parent</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Gallery App</name>
  <modules>
    <module>gallery-domain</module>
    <module>gallery-persistence</module>
    <module>gallery-core</module>
    <module>gallery-ai</module>
    <module>gallery-review</module>
    <module>gallery-web</module>
    <module>gallery-app</module>
  </modules>
  <properties>
    <java.version>25</java.version>
    <postgresql.version>42.7.13</postgresql.version>
    <spring-ai.version>2.0.0</spring-ai.version>
    <thumbnailator.version>0.4.21</thumbnailator.version>
    <metadata-extractor.version>2.20.0</metadata-extractor.version>
    <twelvemonkeys.version>3.13.1</twelvemonkeys.version>
  </properties>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.ai</groupId>
        <artifactId>spring-ai-bom</artifactId>
        <version>${spring-ai.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency><groupId>com.hawkins</groupId><artifactId>gallery-domain</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.hawkins</groupId><artifactId>gallery-persistence</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.hawkins</groupId><artifactId>gallery-core</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.hawkins</groupId><artifactId>gallery-ai</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.hawkins</groupId><artifactId>gallery-review</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.hawkins</groupId><artifactId>gallery-web</artifactId><version>${project.version}</version></dependency>
    </dependencies>
  </dependencyManagement>
  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId>
          <configuration>
            <parameters>true</parameters>
            <annotationProcessorPaths>
              <path><groupId>org.projectlombok</groupId><artifactId>lombok</artifactId><version>${lombok.version}</version></path>
            </annotationProcessorPaths>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
